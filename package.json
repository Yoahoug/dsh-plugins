{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness out-of-tree plugin monorepo: capability-seam plugins installed via dsh plugin --profile",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
